# Northstar Institute CRM: the project folder IS the web root (copy institute-crm/ into htdocs as-is).
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:app|bin|storage|tests|vendor|docs|releases|\.git)(?:/|$) - [F,L,NC]
RewriteRule ^(?:config(?:\.example)?\.php|README\.md|composer\.(?:json|lock)|.*\.sqlite.*)$ - [F,L,NC]
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
